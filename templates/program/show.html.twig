{% extends 'base.html.twig' %}

{% block title %}Série #{{ program.id }}{% endblock %}

{% block body %}
    <div class="d-flex align-items-start gap-3">
        {% if program.image %}
            <img
                src="{{ program.image }}"
                alt="Affiche de {{ program.name }}"
                class="img-fluid"
                style="max-width: 200px;"
            >
        {% endif %}

        <div>
            <h1>{{ program.name }}</h1>

            <p>{{ program.description }}</p>

            <p>Catégorie : {{ program.category.name }}</p>
        </div>
    </div>

    <h2 class="mt-4">Saisons disponibles</h2>

<ul>
    {% for season in seasons|sort((a, b) => a.number <=> b.number) %}
        <li>
            <a href="{{ path('program_season_show', {
                programId: program.id,
                seasonId: season.id
            }) }}">
                Saison {{ season.number }} — {{ season.year }}
            </a>
        </li>
    {% else %}
        <li>Aucune saison disponible pour cette série.</li>
    {% endfor %}
</ul>

    <a href="{{ path('program_index') }}">
        Retour à la liste des programmes
    </a>
{% endblock %}
