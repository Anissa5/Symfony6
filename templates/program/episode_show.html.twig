{% extends 'base.html.twig' %}

{% block title %}
    Épisode {{ episode.number }} — {{ episode.name }}
{% endblock %}

{% block body %}
    <div class="container my-4">
        <h1>{{ program.name }}</h1>

        <h2>Saison {{ season.number }}</h2>

        <h3>Épisode {{ episode.number }} : {{ episode.name }}</h3>

        <p>{{ episode.description }}</p>

        <a href="{{ path('program_season_show', {
            'programId': program.id,
            'seasonId': season.id
        }) }}">
            Retour à la saison
        </a>
    </div>
{% endblock %}
