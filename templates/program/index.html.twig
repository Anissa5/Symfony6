{% extends 'base.html.twig' %}

{% block body %}
    <h1>Mes séries</h1>

    {% for program in programs %}
        <h2>{{ program.title }}</h2>

        <p>{{ program.summary }}</p>
        <p>Catégorie : {{ program.category.name }}</p>

        <a href="{{ path('program_show', { id: program.id }) }}">
            Voir la fiche
        </a>

    {% else %}
        <p>Aucune série trouvée.</p>
    {% endfor %}
{% endblock %}
